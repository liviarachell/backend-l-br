# Copie este arquivo para .env e preencha os valores
PORT=3000

# Endereço do seu front-end (usado no CORS e nos links dos e-mails)
FRONTEND_URL=http://localhost:5500

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=lebrasil

# Chave secreta do login (use uma string longa e aleatória)
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# E-mail (SMTP). Exemplo com Gmail: use uma "senha de app"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
MAIL_FROM="LêBrasil <seuemail@gmail.com>"

# Para onde chegam as mensagens do formulário de contato
CONTACT_TO=seuemail@gmail.com
